# TerraSense NER Environment Configuration

# NASA Earthdata Login Credentials (Required for fetching real NASA GPM IMERG precipitation)
# 1. Register for free at: https://urs.earthdata.nasa.gov/
# 2. Authorize "NASA GESDISC DATA ARCHIVE" application in your profile (Applications -> Authorized Apps)
# 3. Generate a Personal Access Token at: https://urs.earthdata.nasa.gov/users/new?tab=token
EARTHDATA_TOKEN=your_earthdata_token_here

# Alternatively, Earthdata username and password can be used:
# EARTHDATA_USERNAME=your_username
# EARTHDATA_PASSWORD=your_password

# Frontend URL (for FastAPI CORS in production)
FRONTEND_URL=https://terrasense-frontend.vercel.app

# Optional Phase 3A persistence tooling; runtime APIs remain file-backed.
# Local development defaults only. Never use these credentials in production.
DATABASE_URL=postgresql+psycopg://terrasense:terrasense@localhost:5432/terrasense
