# Copy to backend/.env.local. Never commit credentials.
DATABASE_URL=postgresql://terrasense:terrasense_local_only@localhost:5432/terrasense
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SENSOR_TOPIC=terrasense.sensor.telemetry
KAFKA_FIELD_REPORT_TOPIC=terrasense.field.reports
KAFKA_GROUP_ID=terrasense-local
SENSOR_MODE=SIMULATED
PHOTO_SCREENING_MODE=OPENCV_SCREENING_ONLY

# Optional NASA Earthdata token for refresh scripts.
EARTHDATA_TOKEN=
