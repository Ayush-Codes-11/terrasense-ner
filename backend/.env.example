# TerraSense NER — backend environment variables
# Copy to .env and fill in values before running.
# Never commit .env to git.

# Which data mode to use. "sample" = data/sample/*.geojson
DATA_MODE=sample

# Absolute or relative path to the repo root (used to locate data/sample/)
# Leave empty to auto-detect from __file__ location (recommended).
REPO_ROOT=
